{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-trainer.local/schemas/training-run-request/v1",
  "title": "Model training run request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "game", "algorithm", "mode", "iterations", "seed", "reportEvery"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "game": {"const": "kuhn-poker"},
    "algorithm": {"const": "cfr"},
    "mode": {"enum": ["visual", "headless"]},
    "iterations": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "seed": {"type": "integer"},
    "reportEvery": {"type": "integer", "minimum": 1}
  }
}
