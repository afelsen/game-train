{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-trainer.local/schemas/training-run-request/v1",
  "title": "Model training run request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "game", "algorithm", "mode", "iterations", "seed", "reportEvery"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "game": {"enum": ["kuhn-poker", "leduc-holdem", "restricted-hu-nlhe-flop"]},
    "algorithm": {"enum": ["cfr", "external-sampling-mccfr"]},
    "mode": {"enum": ["visual", "headless"]},
    "iterations": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "seed": {"type": "integer"},
    "reportEvery": {"type": "integer", "minimum": 1},
    "checkpoint": {"$ref": "#/$defs/checkpoint"}
  },
  "$defs": {
    "checkpoint": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schemaVersion", "game", "algorithm", "seed", "completedIterations", "nodes", "checkpointHash"],
      "properties": {
        "schemaVersion": {"const": "1.0.0"},
        "game": {"enum": ["kuhn-poker", "leduc-holdem", "restricted-hu-nlhe-flop"]},
        "algorithm": {"enum": ["cfr", "external-sampling-mccfr"]},
        "seed": {"type": "integer"},
        "completedIterations": {"type": "integer", "minimum": 0},
        "checkpointHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["regretSum", "strategySum"],
            "properties": {
              "regretSum": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "number"}},
              "strategySum": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "number"}},
              "policy": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}
            }
          }
        }
      }
    }
  }
}
