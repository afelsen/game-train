{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-trainer.local/schemas/training-run-event/v1",
  "title": "Model training progress event",
  "type": "object",
  "required": ["schemaVersion", "event", "configHash"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "event": {"enum": ["started", "progress", "complete", "failed"]},
    "configHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifactHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "game": {"enum": ["kuhn-poker", "leduc-holdem", "restricted-hu-nlhe-flop"]},
    "algorithm": {"enum": ["cfr", "external-sampling-mccfr"]},
    "mode": {"enum": ["visual", "headless"]},
    "iteration": {"type": "integer", "minimum": 0},
    "iterations": {"type": "integer", "minimum": 0},
    "gameValue": {"type": "number"},
    "exploitability": {"type": "number", "minimum": 0},
    "referenceScore": {"type": "number"},
    "positiveRegret": {"type": "number", "minimum": 0},
    "normalizedPositiveRegret": {"type": "number", "minimum": 0},
    "heldoutCoverage": {"type": "integer", "minimum": 0},
    "meanActionL1": {"type": ["number", "null"], "minimum": 0},
    "weightedEvLossBb": {"type": ["number", "null"], "minimum": 0},
    "informationSets": {"type": "integer", "minimum": 0},
    "elapsedMs": {"type": "integer", "minimum": 0},
    "strategy": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["informationSet", "actions"],
        "properties": {
          "informationSet": {"type": "string"},
          "label": {"type": "string"},
          "player": {"enum": [0, 1]},
          "card": {"enum": ["J", "Q", "K"]},
          "history": {"type": "string"},
          "actions": {
            "type": "object",
            "properties": {
              "pass": {"type": "number", "minimum": 0, "maximum": 1},
              "bet": {"type": "number", "minimum": 0, "maximum": 1},
              "call": {"type": "number", "minimum": 0, "maximum": 1},
              "raise": {"type": "number", "minimum": 0, "maximum": 1},
              "fold": {"type": "number", "minimum": 0, "maximum": 1},
              "check": {"type": "number", "minimum": 0, "maximum": 1}
              ,"bet-50": {"type": "number", "minimum": 0, "maximum": 1}
              ,"bet-100": {"type": "number", "minimum": 0, "maximum": 1}
              ,"raise-2.5x": {"type": "number", "minimum": 0, "maximum": 1}
              ,"all-in": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "required": ["schemaVersion", "game", "algorithm", "seed", "completedIterations", "nodes", "checkpointHash"],
      "properties": {
        "schemaVersion": {"const": "1.0.0"},
        "game": {"enum": ["kuhn-poker", "leduc-holdem", "restricted-hu-nlhe-flop"]},
        "algorithm": {"enum": ["cfr", "external-sampling-mccfr"]},
        "seed": {"type": "integer"},
        "completedIterations": {"type": "integer", "minimum": 0},
        "nodes": {"type": "object"},
        "checkpointHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "error": {"type": "string"}
  }
}
