{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-trainer.local/schemas/model-manifest/v1",
  "title": "game train model manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "displayName", "providerType", "game", "capabilities",
    "actionAbstraction", "encoder", "source", "artifacts", "status"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "displayName": {"type": "string", "minLength": 1},
    "providerType": {"enum": ["static-policy", "realtime-solver", "composite", "heuristic"]},
    "game": {"enum": ["nlhe", "leduc-holdem", "kuhn-poker"]},
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["playerCounts", "streets", "stackDepthBb", "returnsActionEv"],
      "properties": {
        "playerCounts": {"type": "array", "items": {"type": "integer", "minimum": 2}, "minItems": 1, "uniqueItems": true},
        "streets": {"type": "array", "items": {"enum": ["preflop", "flop", "turn", "river"]}, "minItems": 1, "uniqueItems": true},
        "stackDepthBb": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": {"min": {"type": "number", "minimum": 0}, "max": {"type": "number", "exclusiveMinimum": 0}}}
          ]
        },
        "returnsActionEv": {"type": "boolean"}
      }
    },
    "actionAbstraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "actions"],
      "properties": {
        "version": {"type": "string"},
        "actions": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
      }
    },
    "encoder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "format"],
      "properties": {
        "version": {"type": "string"},
        "format": {"type": "string"},
        "dimensions": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "license", "retrievedAt"],
      "properties": {
        "repository": {"type": "string", "format": "uri"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "license": {"type": "string"},
        "retrievedAt": {"type": "string", "format": "date-time"},
        "notes": {"type": "string"}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "role"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "role": {"enum": ["checkpoint", "policy", "regrets", "metadata", "source-archive", "auxiliary-data"]}
        }
      }
    },
    "status": {"enum": ["candidate", "accepted", "rejected", "reference-only"]},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
